# Server-only secrets. Replace values in Vercel settings, then redeploy.
OPENROUTER_API_KEY=REPLACE_ME_OPENROUTER_API_KEY
X_BEARER_TOKEN=REPLACE_ME_X_BEARER_TOKEN

# Optional API fallback and screenshot model (must support images)
OPENROUTER_MODEL=~anthropic/claude-sonnet-latest

# Paid-feature protection. Paid routes stay locked while INVITE_CODES is empty.
INVITE_CODES=
# Required in production: 32+ random characters used to sign invite cookies (openssl rand -base64 32).
INVITE_COOKIE_SECRET=
# Paid features are ON only when this is exactly "true" (any case). In production, unset or anything else
# (including typos) means OFF: every paid route returns 503 and the UI disables those features.
PAID_FEATURES_ENABLED=true
PAID_DAILY_CAP_PER_IP=20
PAID_DAILY_CAP_GLOBAL=300

# Shared counters and passkey storage (use either pair). Required in production; dev/test fall back to in-memory counters. Passkey sign-in is off without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Owner passkey sign-in (WebAuthn). Needs Redis above. Password 16+ chars, secret 32+ chars.
OWNER_PASSWORD=
SESSION_SECRET=
# The setup token (32+ chars) enrolls the FIRST passkey only; remove it afterwards.
PASSKEY_SETUP_TOKEN=
# Required in production (passkey sign-in fails closed without both), e.g. x-rex.vercel.app and https://x-rex.vercel.app.
# Leave blank for Preview/local, which use the request host.
WEBAUTHN_RP_ID=
# Comma-separated origins on WEBAUTHN_RP_ID; the same-origin check accepts only these when set.
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=
